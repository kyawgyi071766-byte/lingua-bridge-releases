{
  "name": "lingua-saas",
  "version": "1.4.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "cap:init": "cap add android && cap add ios",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "electron:dev": "electron electron/main.js",
    "electron:build": "node scripts/write-electron-config.js && electron-builder",
    "electron:build:win": "node scripts/write-electron-config.js && electron-builder --win",
    "electron:build:mac": "node scripts/write-electron-config.js && electron-builder --mac",
    "electron:build:linux": "node scripts/write-electron-config.js && electron-builder --linux",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "verify:config": "node scripts/preflight.js",
    "audit:static": "node scripts/static-audit.js",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "check:distribution": "node scripts/distribution-check.js",
    "audit:update": "node scripts/update-feed-audit.js",
    "audit:devices": "node scripts/device-limit-audit.js",
    "audit:official": "node scripts/official-release-audit.js",
    "audit:payment-release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/tron-transfer-policy.test.mjs tests/download-access.test.mjs",
    "audit:gemini": "node scripts/gemini-translator-audit.js",
    "audit:public-release": "node scripts/public-release-audit.js",
    "audit:global-public": "node scripts/global-public-release-audit.js",
    "audit:safe-send-payment": "node scripts/safe-send-payment-audit.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "postcss": "^8.4.40",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
