# ---- Core security ----
# Generate a long random value, for example: openssl rand -hex 32
AUTH_SECRET=replace-with-random-32-byte-or-longer-secret

# ---- Production PostgreSQL database ----
# Use Neon, Supabase, Railway, Vercel Postgres, or another managed PostgreSQL service.
DATABASE_URL=postgresql://user:password@host:5432/lingua?sslmode=require

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=sshksshk2002@gmail.com
ADMIN_EMAIL=you@your-domain.com
# Optional Google Search Console HTML meta verification token.
GOOGLE_SITE_VERIFICATION=

# ---- Translation providers ----
# Configure at least one. In auto mode Lingua uses the best available provider and can fall back.
DEEPL_API_KEY=replace-with-deepl-key
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# Gemini broad-language fallback. Keep this server-side only.
GEMINI_API_KEY=replace-with-gemini-api-key
# Stable low-latency model; may be changed without rebuilding the desktop app.
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
# Optional multimodal model for receipt-image screening. Payment is never activated from AI/image review alone.
GEMINI_RECEIPT_MODEL=gemini-3.8-flash

MICROSOFT_TRANSLATOR_KEY=replace-with-microsoft-translator-key
# Optional for a global single-service Translator resource; required for regional/multi-service resources.
MICROSOFT_TRANSLATOR_REGION=
# Keep the global endpoint unless Azure gives you a custom Translator endpoint.
MICROSOFT_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
GOOGLE_TRANSLATE_API_KEY=replace-with-google-key
TRANSLATE_PROVIDER=auto
# Explicit safe fallback chain for this candidate. Unsupported DeepL pairs are skipped automatically.
TRANSLATE_CHAIN=deepl,gemini,microsoft,google
# Used only when TRANSLATE_CHAIN is empty.
TRANSLATE_PRIMARY=google

# ---- Crypto payments (USDT -> owner Trust Wallet) ----
# Lingua Bridge v1.0.22 public release accepts USDT on TRON only.
CRYPTO_CHAIN=tron
CRYPTO_WALLET_ADDRESS=TC4gLVT6RnjdnMB6qCgq2mAb5KNnM9ovzM
# TronScan API key is optional but recommended for production reliability/rate limits.
TRONSCAN_API_KEY=
# Required when CRYPTO_CHAIN=bsc.
BSCSCAN_API_KEY=
# Optional overrides. Defaults are the standard USDT contracts used by Lingua.
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# ---- AI customer support ----
# Optional. If OPENAI_API_KEY is empty, the support widget uses a built-in keyword responder.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ---- Legacy Stripe integration (not shown in the UI) ----
# These routes/files are kept for backwards compatibility only. Leave disabled unless you intentionally use them.
LEGACY_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- Transactional email / account security ----
# Production defaults to requiring verified email unless explicitly set false.
EMAIL_VERIFICATION_REQUIRED=true
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Lingua <no-reply@your-domain.com>

# ---- Plan limits ----
# Free monthly Unicode character quota. 0 disables free translation.
FREE_QUOTA_CHARS=500

# ---- Native wrappers ----
# Must be the same deployed HTTPS origin users access in the browser.
SERVER_URL=https://your-domain.com

# ---- Native-app distribution ----
# Public launch: set DOWNLOAD_ACCESS_MODE=public and use a direct HTTPS release asset URL.
# For private testing, set it to private and configure DOWNLOAD_ACCESS_TOKEN.
DOWNLOAD_ACCESS_MODE=public
DOWNLOAD_ACCESS_TOKEN=
DOWNLOAD_ANDROID_URL=
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_MAC_URL=
DOWNLOAD_LINUX_URL=
# Real iPhone installs should use TestFlight/App Store (https URL), not an unsigned IPA.
DOWNLOAD_IOS_URL=

# ---- Desktop verified update feed ----
# After building/testing v1.0.22, upload the installer to an HTTPS release host,
# then set the exact version, URL and SHA-256 shown by the Windows build script.
DESKTOP_STABLE_VERSION=1.0.22
DESKTOP_STABLE_WINDOWS_URL=
DESKTOP_STABLE_WINDOWS_SHA256=
DESKTOP_STABLE_RELEASE_NOTES=Lingua Bridge v1.0.22 global public release
DESKTOP_STABLE_MANDATORY=false
# Optional owner/beta channel.
DESKTOP_BETA_VERSION=
DESKTOP_BETA_WINDOWS_URL=
DESKTOP_BETA_WINDOWS_SHA256=
DESKTOP_BETA_RELEASE_NOTES=
DESKTOP_BETA_MANDATORY=false
