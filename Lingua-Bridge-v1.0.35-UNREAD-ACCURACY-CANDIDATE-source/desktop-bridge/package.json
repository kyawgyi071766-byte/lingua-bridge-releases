{
  "name": "lingua-bridge-desktop",
  "version": "1.0.35",
  "private": true,
  "description": "Lingua Bridge v1.0.35 unread accuracy candidate.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "node scripts/build-static.cjs",
    "build": "node scripts/build-static.cjs && electron-builder --config electron-builder.candidate.json",
    "build:win": "node scripts/build-static.cjs && electron-builder --config electron-builder.candidate.json --win nsis",
    "start": "electron .",
    "validate": "node scripts/validate.cjs",
    "preflight": "node scripts/preflight.cjs",
    "qa": "node scripts/preflight.cjs && node scripts/validate.cjs && node scripts/admin-custom-audit.cjs && node scripts/ux-v1.0.28-audit.cjs && node scripts/ux-v1.0.29-audit.cjs && node scripts/ux-v1.0.30-audit.cjs && node scripts/whatsapp-composer-regression.cjs && node scripts/incoming-queue-regression.cjs && node scripts/sent-card-regression.cjs && node scripts/unread-accuracy-regression.cjs && node --check electron/main.cjs && node --check electron/host-preload.cjs && node --check electron/service-preload.cjs && node --check src/app.js && node --check scripts/build-static.cjs",
    "build:win:candidate": "node scripts/build-static.cjs && electron-builder --config electron-builder.candidate.json --win nsis",
    "build:win:no-nsis": "node scripts/build-static.cjs && electron-builder --config electron-builder.no-nsis.json --win zip --x64",
    "build:win:public": "node scripts/build-static.cjs && electron-builder --config electron-builder.public-installer.json --win nsis --x64",
    "build:win:public:zip": "node scripts/build-static.cjs && electron-builder --config electron-builder.public-zip.json --win zip --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.lingua.bridge",
    "productName": "Lingua Bridge",
    "artifactName": "Lingua-Bridge-Setup-${version}.${ext}",
    "directories": {
      "output": "release-v1.0.35-public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/lingua.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lingua Bridge",
      "installerIcon": "build/lingua.ico",
      "uninstallerIcon": "build/lingua.ico"
    }
  }
}
